# Network: "mainnet" (default) or "testnet".
# Chain ID, explorer, WETH and the Uniswap v2 deployment are verified constants in
# config/chains.ts, not environment variables. See HANDOFF.md.
#
# Uniswap v2 is deployed on mainnet (4663) only. On testnet (46630) the swap and
# pool surfaces report "Contract Not Configured".
NEXT_PUBLIC_POOLIX_NETWORK=mainnet

# Optional browser RPC override. Leave empty to use the endpoint in config/chains.ts.
# Every NEXT_PUBLIC_ value is visible to all visitors, so never put a keyed provider URL here.
#
# The default is PublicNode's gateway. Robinhood's own endpoint
# (https://rpc.mainnet.chain.robinhood.com) is rate-limited and blocked by some
# networks; it is kept in config/chains.ts under rpcUrls.robinhood.
NEXT_PUBLIC_RPC_URL=

# Server-only RPC for route handlers and the pool scan. Use a keyed provider here: the
# public endpoint throttles bulk reads and rejects archive queries, which is why volume,
# fees and APR read "--".
RPC_URL=

# How many of the newest pairs the pool scan inspects. The scan is paced and time-boxed,
# so a larger window needs a provider with real rate limits.
POOLIX_POOL_SCAN_WINDOW=300

# Absolute origin, used for OpenGraph image URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Envio HyperSync token, used server-side to read historical Uniswap v2 Swap events for
# Trading Volume and Trading Fees. Free token: https://app.envio.dev/api-tokens
# Sent as "Authorization: Bearer <token>"; the path and query-parameter forms are ignored.
#
# Leave empty and those two figures read "--" rather than a guess. Never rename this to
# NEXT_PUBLIC_*, which would inline the token into the browser bundle.
ENVIO_API_TOKEN=

# Optional overrides for a local fork or a future Poolix deployment. Leave empty to
# use the verified mainnet addresses. An invalid value is reported, never silently
# replaced by the verified one.
NEXT_PUBLIC_UNISWAP_V2_FACTORY_ADDRESS=
NEXT_PUBLIC_UNISWAP_V2_ROUTER_ADDRESS=
