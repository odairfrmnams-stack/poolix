{
  "name": "poolix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:chain": "tsx scripts/verify-deployments.ts",
    "verify:swaps": "tsx --env-file-if-exists=.env.local scripts/verify-swap-window.ts",
    "verify:transactions": "tsx --env-file-if-exists=.env.local scripts/verify-transactions.ts",
    "verify:tvl": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-tvl.ts",
    "verify:holders": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-holders.ts",
    "verify:tokens": "tsx --conditions=react-server scripts/verify-tokens.ts",
    "verify:historical": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-historical.ts",
    "verify:liquidity-history": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-liquidity-history.ts",
    "verify:apr": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-apr.ts",
    "verify:pool-analytics": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-pool-analytics.ts",
    "verify:dashboard": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-dashboard.ts",
    "verify:portfolio": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-portfolio.ts",
    "verify:infrastructure": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-infrastructure.ts",
    "verify:security": "tsx --env-file-if-exists=.env.local scripts/verify-security.ts",
    "verify:pons": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-pons.ts",
    "measure:routes": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/measure-routes.ts",
    "bootstrap:history": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/bootstrap-history.ts",
    "test": "tsx --test \"{config,lib,services,hooks}/**/*.test.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.56.7",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
